{
  "name": "voiceoffice-booking-system",
  "version": "1.0.0",
  "description": "Online booking system with VoiceOffice, multi-tenancy, templates, and Meta integration",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
